includes:
  - phpstan-baseline.neon

parameters:
  level: 8
  phpVersion: 80100
  paths:
    - src
  bootstrapFiles:
    - tests/phpstan-bootstrap.php
  # WordPress comes from szepeviktor/phpstan-wordpress, but WooCommerce does
  # not. Without these, every WC_Order call reads as a call on an unknown class
  # and Action Scheduler's functions read as undefined -- roughly 28 findings
  # that are a missing configuration line rather than a defect.
  scanFiles:
    - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
    # Action Scheduler ships inside WooCommerce but is missing from its stubs.
    - tests/stubs/action-scheduler.php

  ignoreErrors:
    # $wpdb->prepare() is typed to accept only a literal-string, but the table
    # name has to be interpolated from $wpdb. WordPress 6.2 added the %i
    # identifier placeholder that would avoid this; this plugin supports 6.0,
    # so interpolation is still the only option. The interpolated value is
    # $wpdb's own property, never user input.
    -
      message: '#expects literal-string, non-falsy-string given#'
      paths:
        - src/Support/DbLock.php
        - src/Support/DbRateLimiter.php
