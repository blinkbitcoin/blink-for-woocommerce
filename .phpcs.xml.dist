<?xml version="1.0"?>
<ruleset name="Blink for WooCommerce">
  <description>
    Security and WordPress-API correctness only.

    Formatting is prettier's job (see the prettier block in package.json). The
    previous ruleset asked for the full WordPress standard -- tabs, Yoda
    conditions, snake_case, aligned array arrows -- every one of which
    contradicts the code actually in this repository, which is why it could
    never be run.
  </description>

  <file>src</file>
  <file>blink-for-woocommerce.php</file>
  <file>tests</file>

  <!--
    The WordPress security and API sniffs below apply to shipped code. Test
    fixtures deliberately read raw superglobals and build unescaped messages,
    and tests/ is excluded from the distributed package (.distignore), so
    applying them there is noise rather than signal. PHPCompatibility still
    runs everywhere, because a PHP version problem in a test is a real one.
  -->
  <rule ref="WordPress.Security">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>
  <rule ref="WordPress.WP">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>
  <rule ref="WordPress.DB">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>

  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/build/*</exclude-pattern>

  <arg name="extensions" value="php"/>
  <arg name="basepath" value="./"/>
  <arg name="parallel" value="8"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <!-- The plugin requires PHP 8.1; the old value here claimed 5.6. -->
  <config name="testVersion" value="8.1-"/>
  <rule ref="PHPCompatibilityWP">
    <!--
      This sniff predates enums and reports $this inside an enum method as
      "$this in a plain function". Enums require PHP 8.1, which is this
      plugin's floor, so the construct is always valid here.
    -->
    <exclude name="PHPCompatibility.Variables.ForbiddenThisUseContexts"/>
  </rule>

  <config name="minimum_supported_wp_version" value="6.0"/>

  <rule ref="WordPress.Security.EscapeOutput"/>
  <rule ref="WordPress.Security.NonceVerification"/>
  <rule ref="WordPress.Security.ValidatedSanitizedInput"/>
  <rule ref="WordPress.Security.SafeRedirect"/>
  <rule ref="WordPress.DB.PreparedSQL"/>
  <rule ref="WordPress.WP.GlobalVariablesOverride"/>
  <rule ref="WordPress.WP.EnqueuedResourceParameters"/>

  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array" value="blink-for-woocommerce"/>
    </properties>
  </rule>

  <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
    <properties>
      <property name="prefixes" type="array" value="blink,BLINK,Blink"/>
    </properties>
    <!--
      Test doubles have to use the names of the things they stand in for
      (WC_Logger, ABSPATH), and test files are never shipped.
    -->
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>

  <!--
    Tests deliberately reach into globals and build SQL directly to assert on
    storage; the production rules above are what matter.
  -->
  <rule ref="WordPress.DB.PreparedSQL">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>
  <rule ref="WordPress.WP.GlobalVariablesOverride">
    <exclude-pattern>tests/*</exclude-pattern>
  </rule>
</ruleset>
