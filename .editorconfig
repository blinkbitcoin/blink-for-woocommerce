# Matches what prettier actually produces for this repository. The previous
# values (tabs, width 4) told editors to write code prettier would immediately
# rewrite.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{php,js,ts,json,yml,yaml,md,css}]
indent_style = space
indent_size = 2

# WordPress.org readmes are distributed with CRLF line endings.
[*.txt]
end_of_line = crlf
trim_trailing_whitespace = false
