{
  "name": "blink-for-woocommerce",
  "version": "0.3.0",
  "main": "Gruntfile.cjs",
  "author": "Blink",
  "scripts": {
    "prettier:check": "prettier -c blink-for-woocommerce.php src assets/js/frontend/pay.js assets/js/backend tests/js",
    "prettier:fix": "prettier -w blink-for-woocommerce.php src assets/js/frontend/pay.js assets/js/backend tests/js",
    "start": "grunt default",
    "readme": "grunt readme",
    "i18n": "grunt i18n",
    "test:js": "vitest run",
    "test:js:watch": "vitest",
    "test:js:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint:js": "eslint assets/js/frontend/pay.js assets/js/frontend/blocks.js assets/js/backend tests/js",
    "test:e2e:setup": "bash bin/install-e2e-site.sh"
  },
  "devDependencies": {
    "@prettier/plugin-php": "^0.22.2",
    "grunt": "^1.6.1",
    "grunt-wp-i18n": "^1.0.3",
    "grunt-wp-readme-to-markdown": "^2.1.0",
    "prettier": "^3.3.3",
    "@vitest/coverage-istanbul": "^2.1.8",
    "vitest": "^2.1.8",
    "jsdom": "^25.0.1",
    "eslint": "^9.17.0",
    "@playwright/test": "^1.49.1"
  },
  "prettier": {
    "plugins": [
      "@prettier/plugin-php"
    ],
    "printWidth": 90,
    "useTabs": false,
    "tabWidth": 2,
    "singleQuote": true,
    "braceStyle": "1tbs"
  },
  "type": "module"
}
